<h1>Kittens</h1>

<% if flash[:notice] %>
  <p class="notice"><%= flash[:notice] %></p>
<% end %>

<div>
    <% @kittens.each do |kitten| %>
       <%= render partial: "kitten", locals: { kitten: kitten } %>

       <%= button_to "Delete", kitten_path(kitten), method: :delete, data: { turbo_confirm: "Are you sure?" } %>
    <% end %>
</div>